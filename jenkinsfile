pipeline {
    agent { label 'jenkins-Agent' }

    tools {
        jdk 'Java17'
        maven 'Maven3'
    }

    environment {

        SONAR_SCANNER_HOME = tool 'sonar'

        APP_NAME = 'register-app-pipeline'
        RELEASE_VERSION = "1.0.${BUILD_NUMBER}"

        DOCKER_USER = 'akshaydudwadkar'
        DOCKER_IMAGE = "${DOCKER_USER}/${APP_NAME}"
        IMAGE_TAG = "${RELEASE_VERSION}-${BUILD_NUMBER}"
    }

    stages {

        stage('Cleanup Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout Code') {
            steps {
                git url: 'https://github.com/Akshay-Dudwadkar/register-app',
                    branch: 'test',
                    credentialsId: 'github1'
            }
        }

        stage('Build & Test') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh """
                    mvn sonar:sonar \
                    -Dsonar.projectKey=register-app \
                    -Dsonar.projectName=register-app
                    """
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    def appImage = docker.build("${DOCKER_IMAGE}:${IMAGE_TAG}")
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub') {

                        def appImage = docker.image("${DOCKER_IMAGE}:${IMAGE_TAG}")

                        appImage.push("${IMAGE_TAG}")
                        appImage.push("latest")
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline completed successfully!"
        }

        failure {
            echo "❌ Pipeline failed. Check logs."
        }
    }
}