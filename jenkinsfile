def docker_image

pipeline {
    agent { label 'jenkins-Agent' }

    tools {
        jdk 'Java17'
        maven 'Maven3'
    }

    environment {
        SONAR_SCANNER_HOME = tool 'sonar'

        APP_NAME = 'register-app-pipeline'
        DOCKER_USER = 'akshaydudwadkar'
        DOCKER_CREDENTIAL_ID = 'dockerhub'

        DOCKER_IMAGE = "${DOCKER_USER}/${APP_NAME}"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Cleanup Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'test',
                    credentialsId: 'github1',
                    url: 'https://github.com/Akshay-Dudwadkar/register-app'
            }
        }

        stage('Build & Test') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh """
                        mvn sonar:sonar \
                        -Dsonar.projectKey=register-app \
                        -Dsonar.projectName=register-app
                    """
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    docker_image = docker.build("${DOCKER_IMAGE}:${IMAGE_TAG}")
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKER_CREDENTIAL_ID) {

                        docker_image.push("${IMAGE_TAG}")

                        docker_image.push("latest")
                    }
                }
            }
        }

        stage('Trivy Image Scan') {
           steps {
              sh '''
             docker run --rm \
             -v /var/run/docker.sock:/var/run/docker.sock \
             aquasec/trivy:latest image \
             --no-progress \
             --scanners vuln \
             --exit-code 0 \
             --severity HIGH,CRITICAL \
             --format table \
             ${DOCKER_IMAGE}:latest
             '''
            }
        }

        stage('Cleanup Artifacts') {
          steps {
            script {
             sh """
                docker rmi ${DOCKER_IMAGE}:${IMAGE_TAG} || true
                docker rmi ${DOCKER_IMAGE}:latest || true
              """
            }
          }
        }

    }



    post {
        success {
            echo "✅ Pipeline completed successfully!"
        }

        failure {
            echo "❌ Pipeline failed. Check logs."
        }

        always {
            sh 'docker logout || true'
        }
    }
}